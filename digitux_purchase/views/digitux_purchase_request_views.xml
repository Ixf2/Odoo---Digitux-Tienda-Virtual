<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vista lista -->
        <record id="view_digitux_purchase_request_list" model="ir.ui.view">
            <field name="name">digitux.purchase.request.list</field>
            <field name="model">digitux.purchase.request</field>
            <field name="arch" type="xml">
                <list string="Solicitudes de Compra"
                      decoration-danger="state == 'cancelled'"
                      decoration-success="state == 'purchased'">
                    <field name="name"/>
                    <field name="supplier_id"/>
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="total_estimated"/>
                    <field name="required_date"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Vista formulario -->
        <record id="view_digitux_purchase_request_form" model="ir.ui.view">
            <field name="name">digitux.purchase.request.form</field>
            <field name="model">digitux.purchase.request</field>
            <field name="arch" type="xml">
                <form string="Solicitud de Compra">
                    <header>
                        <button name="action_confirm" string="Confirmar"
                                type="object" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_create_purchase_order"
                                string="Crear Orden de Compra"
                                type="object" class="btn-primary"
                                invisible="state != 'confirmed'"/>
                        <button name="action_view_purchase_order"
                                string="Ver Orden de Compra"
                                type="object"
                                invisible="not purchase_order_id"/>
                        <button name="action_cancel" string="Cancelar"
                                type="object"
                                invisible="state not in ('draft', 'confirmed')"/>
                        <button name="action_reset_draft" string="Reiniciar"
                                type="object"
                                invisible="state != 'cancelled'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirmed,purchased"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="supplier_id"/>
                                <field name="product_id"/>
                            </group>
                            <group>
                                <field name="quantity"/>
                                <field name="estimated_price"/>
                                <field name="total_estimated" readonly="1"/>
                                <field name="required_date"/>
                            </group>
                        </group>
                        <group invisible="not purchase_order_id">
                            <field name="purchase_order_id" readonly="1"/>
                        </group>
                        <field name="notes" widget="text" placeholder="Notas..."/>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Acción -->
        <record id="action_digitux_purchase_request" model="ir.actions.act_window">
            <field name="name">Solicitudes de Compra</field>
            <field name="res_model">digitux.purchase.request</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menús -->
        <menuitem id="menu_digitux_purchase_root"
                  name="Digitux Compras"
                  sequence="20"/>

        <menuitem id="menu_digitux_purchase_solicitudes"
                  name="Solicitudes de Compra"
                  parent="menu_digitux_purchase_root"
                  sequence="10"
                  action="action_digitux_purchase_request"/>

    </data>
</odoo>
