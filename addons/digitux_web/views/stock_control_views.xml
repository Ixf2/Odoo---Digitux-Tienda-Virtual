<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_digitux_stock_control_tree" model="ir.ui.view">
        <field name="name">digitux.stock.control.tree</field>
        <field name="model">digitux.stock.control</field>
        <field name="arch" type="xml">
            <tree string="Control de stock" decoration-success="state == 'verified'" decoration-danger="state == 'issue'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="current_stock"/>
                <field name="last_check_date"/>
                <field name="checked_by_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_digitux_stock_control_form" model="ir.ui.view">
        <field name="name">digitux.stock.control.form</field>
        <field name="model">digitux.stock.control</field>
        <field name="arch" type="xml">
            <form string="Control de stock">
                <header>
                    <button name="action_mark_verified" string="Verificado" type="object" class="btn-primary" invisible="state == 'verified'"/>
                    <button name="action_mark_issue" string="Marcar discrepancia" type="object" invisible="state == 'issue'"/>
                    <button name="action_reset_draft" string="Volver a borrador" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,verified,issue"/>
                </header>
                <sheet>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="location_id"/>
                            <field name="current_stock"/>
                        </group>
                        <group>
                            <field name="last_check_date"/>
                            <field name="checked_by_id"/>
                        </group>
                    </group>
                    <field name="notes" nolabel="1" placeholder="Anota ajuste, incidencia o motivo de la revision."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_digitux_stock_control_search" model="ir.ui.view">
        <field name="name">digitux.stock.control.search</field>
        <field name="model">digitux.stock.control</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <filter name="verified" string="Verificados" domain="[('state', '=', 'verified')]"/>
                <filter name="issue" string="Con discrepancia" domain="[('state', '=', 'issue')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_location" string="Ubicacion" context="{'group_by': 'location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_digitux_stock_control" model="ir.actions.act_window">
        <field name="name">Control de stock</field>
        <field name="res_model">digitux.stock.control</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_digitux_stock_control" name="Control de stock" parent="menu_digitux_supply" action="action_digitux_stock_control" sequence="20"/>
</odoo>
