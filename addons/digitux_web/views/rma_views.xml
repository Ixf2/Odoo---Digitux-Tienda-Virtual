<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_digitux_rma_tree" model="ir.ui.view">
        <field name="name">digitux.rma.request.tree</field>
        <field name="model">digitux.rma.request</field>
        <field name="arch" type="xml">
            <tree string="RMA Digitux" decoration-success="state == 'done'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="fault_type"/>
                <field name="in_warranty"/>
                <field name="courier"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_digitux_rma_form" model="ir.ui.view">
        <field name="name">digitux.rma.request.form</field>
        <field name="model">digitux.rma.request</field>
        <field name="arch" type="xml">
            <form string="RMA Digitux">
                <header>
                    <button name="action_submit" type="object" string="Enviar" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Aprobar" class="btn-primary" invisible="state not in ('submitted', 'draft')"/>
                    <button name="action_received" type="object" string="Producto recibido" invisible="state != 'approved'"/>
                    <button name="action_done" type="object" string="Resolver" class="btn-primary" invisible="state != 'received'"/>
                    <button name="action_reject" type="object" string="Rechazar" invisible="state in ('done', 'rejected', 'cancel')"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,received,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_sale_order" icon="fa-shopping-cart" invisible="not sale_order_id">
                            <field name="sale_order_id" widget="statinfo" string="Pedido"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_crm_case" icon="fa-life-ring" invisible="not crm_lead_id">
                            <field name="crm_lead_id" widget="statinfo" string="CRM"/>
                        </button>
                    </div>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="sale_order_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="fault_type"/>
                            <field name="requested_solution"/>
                            <field name="courier"/>
                            <field name="purchase_date"/>
                            <field name="warranty_limit_date"/>
                            <field name="in_warranty"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción cliente">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Recogida">
                            <field name="pickup_address" nolabel="1"/>
                        </page>
                        <page string="Diagnóstico interno">
                            <field name="diagnostic_notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_digitux_rma_kanban" model="ir.ui.view">
        <field name="name">digitux.rma.request.kanban</field>
        <field name="model">digitux.rma.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div><field name="partner_id"/></div>
                            <div><field name="product_id"/></div>
                            <div><field name="state"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_digitux_rma_search" model="ir.ui.view">
        <field name="name">digitux.rma.request.search</field>
        <field name="model">digitux.rma.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter name="submitted" string="Enviadas" domain="[('state', '=', 'submitted')]"/>
                <filter name="in_warranty" string="En garantía" domain="[('in_warranty', '=', True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_fault" string="Tipo" context="{'group_by': 'fault_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_digitux_rma" model="ir.actions.act_window">
        <field name="name">RMA / Garantías</field>
        <field name="res_model">digitux.rma.request</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>
</odoo>
