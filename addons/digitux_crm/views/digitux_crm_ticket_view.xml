<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Árbol (Lista) -->
    <record id="view_ticket_tree" model="ir.ui.view">
        <field name="name">digitus.crm.ticket.tree</field>
        <field name="model">digitus.crm.ticket</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="view_ticket_form" model="ir.ui.view">
        <field name="name">digitus.crm.ticket.form</field>
        <field name="model">digitus.crm.ticket</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="customer_id"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción y Menús -->
    <record id="action_crm_ticket" model="ir.actions.act_window">
        <field name="name">Tickets de Soporte</field>
        <field name="res_model">digitus.crm.ticket</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_digitus_root" name="Soporte Digitux" web_icon="crm,static/description/icon.png"/>
    <menuitem id="menu_tickets" name="Tickets" parent="menu_digitus_root" action="action_crm_ticket"/>
</odoo>