<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_digitux_stock_control_tree" model="ir.ui.view">
        <field name="name">digitux.stock.control.tree</field>
        <field name="model">digitux.stock.control</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="current_stock"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_digitux_stock_control_form" model="ir.ui.view">
        <field name="name">digitux.stock.control.form</field>
        <field name="model">digitux.stock.control</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="location_id"/>
                        </group>
                        <group>
                            <field name="current_stock"/>
                            <field name="last_check_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_digitux_stock_control" model="ir.actions.act_window">
        <field name="name">Control de Stock en Tiempo Real</field>
        <field name="res_model">digitux.stock.control</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_digitux_stock_root" name="Digitux Inventario" sequence="10"/>
    <menuitem id="menu_digitux_stock_control" name="Control de Stock" parent="menu_digitux_stock_root" action="action_digitux_stock_control" sequence="10"/>
</odoo>
